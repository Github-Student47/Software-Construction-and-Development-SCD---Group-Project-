<?xml version="1.0" encoding="UTF-8"?>
<!--
    Apache Ant Build Configuration for University Student Management System
    
    This build.xml file defines the build process for the USMS project.
    It includes targets for cleaning, compiling, testing, and creating WAR files.
    
    Usage:
        ant clean          - Remove all build artifacts
        ant compile        - Compile Java source files
        ant test           - Run unit tests
        ant build          - Create WAR file for deployment
        ant deploy         - Deploy to Tomcat
        ant all            - Run all targets (clean, compile, test, build)
    
    Team Members:
    - Muhammad Kashan Tariq (212145)
    - Adeel Hussain (221829)
    - Syed Abdain (221855)
    - Muhammad Tauseef (221789)
-->
<project name="UniversityStudentManagementSystem" default="build" basedir=".">
    
    <!-- ==================== PROPERTIES ==================== -->
    
    <!-- Directory properties -->
    <property name="src.dir" location="src/main/java"/>
    <property name="test.dir" location="src/test/java"/>
    <property name="resources.dir" location="src/main/resources"/>
    <property name="webapp.dir" location="src/main/webapp"/>
    
    <!-- Build directories -->
    <property name="build.dir" location="build"/>
    <property name="build.classes.dir" location="${build.dir}/classes"/>
    <property name="build.test.dir" location="${build.dir}/test-classes"/>
    <property name="dist.dir" location="dist"/>
    
    <!-- Library directories -->
    <property name="lib.dir" location="lib"/>
    
    <!-- Target filename -->
    <property name="app.name" value="USMS"/>
    <property name="war.file" value="${dist.dir}/${app.name}.war"/>
    
    <!-- Java compilation settings -->
    <property name="java.source" value="17"/>
    <property name="java.target" value="17"/>
    
    <!-- ==================== PATH DEFINITIONS ==================== -->
    
    <!-- Classpath for compilation -->
    <path id="compile.classpath">
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
        <pathelement location="${build.classes.dir}"/>
    </path>
    
    <!-- Classpath for testing -->
    <path id="test.classpath">
        <path refid="compile.classpath"/>
        <pathelement location="${build.test.dir}"/>
        <fileset dir="${lib.dir}" includes="**/*junit*.jar"/>
    </path>
    
    <!-- ==================== INITIALIZATION ==================== -->
    
    <target name="init" description="Initialize build directories">
        <echo message="========================================"/>
        <echo message="Building: ${app.name}"/>
        <echo message="========================================"/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${build.test.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    
    <!-- ==================== CLEAN TARGET ==================== -->
    
    <target name="clean" description="Remove all build artifacts">
        <echo message="Cleaning build directories..."/>
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <echo message="Clean completed!"/>
    </target>
    
    <!-- ==================== COMPILE TARGET ==================== -->
    
    <target name="compile" depends="init" description="Compile Java source files">
        <echo message="Compiling Java source files..."/>
        <javac srcdir="${src.dir}" 
               destdir="${build.classes.dir}"
               source="${java.source}"
               target="${java.target}"
               includeantruntime="false"
               debug="true"
               deprecation="true"
               optimize="true">
            <classpath refid="compile.classpath"/>
        </javac>
        <echo message="Compilation completed!"/>
    </target>
    
    <!-- ==================== COMPILE TEST TARGET ==================== -->
    
    <target name="compile.test" depends="compile" description="Compile test source files">
        <echo message="Compiling test source files..."/>
        <javac srcdir="${test.dir}" 
               destdir="${build.test.dir}"
               source="${java.source}"
               target="${java.target}"
               includeantruntime="false"
               debug="true">
            <classpath refid="test.classpath"/>
        </javac>
        <echo message="Test compilation completed!"/>
    </target>
    
    <!-- ==================== TEST TARGET ==================== -->
    
    <target name="test" depends="compile.test" description="Run unit tests">
        <echo message="Running unit tests..."/>
        <junit printsummary="yes" haltonfailure="yes" fork="yes" timeout="30000">
            <classpath refid="test.classpath"/>
            <formatter type="plain" usefile="false"/>
            <test name="com.scd.project.test.StudentDAOTest"/>
        </junit>
        <echo message="All tests passed!"/>
    </target>
    
    <!-- ==================== BUILD TARGET ==================== -->
    
    <target name="build" depends="compile" description="Create WAR file for deployment">
        <echo message="Building WAR file..."/>
        
        <!-- Copy resources -->
        <copy todir="${build.classes.dir}">
            <fileset dir="${resources.dir}"/>
        </copy>
        
        <!-- Create WAR file -->
        <war destfile="${war.file}" webxml="${webapp.dir}/WEB-INF/web.xml">
            <fileset dir="${webapp.dir}">
                <exclude name="WEB-INF/web.xml"/>
            </fileset>
            <classes dir="${build.classes.dir}"/>
            <lib dir="${lib.dir}">
                <include name="**/*.jar"/>
            </lib>
        </war>
        
        <echo message="WAR file created: ${war.file}"/>
    </target>
    
    <!-- ==================== DEPLOY TARGET ==================== -->
    
    <target name="deploy" depends="build" description="Deploy WAR file to Tomcat">
        <echo message="Deploying to Tomcat..."/>
        <copy file="${war.file}" todir="${catalina.home}/webapps"/>
        <echo message="Deployed successfully to: ${catalina.home}/webapps/${app.name}.war"/>
    </target>
    
    <!-- ==================== RUN TARGET ==================== -->
    
    <target name="run" description="Start the application (requires Tomcat)">
        <echo message="Starting application..."/>
        <echo message="Open your browser and navigate to: http://localhost:8080/${app.name}"/>
    </target>
    
    <!-- ==================== ALL TARGET ==================== -->
    
    <target name="all" depends="clean,build" description="Clean and build the project">
        <echo message="========================================"/>
        <echo message="Build process completed!"/>
        <echo message="WAR file: ${war.file}"/>
        <echo message="========================================"/>
    </target>
    
</project>
